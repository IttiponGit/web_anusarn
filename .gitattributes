* text=auto eol=lf

# Normalize source and configuration files to LF in Git.
*.css text eol=lf
*.csv text eol=lf
*.html text eol=lf
.htaccess text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Do not attempt newline conversion for binary assets.
*.avif binary
*.doc binary
*.docx binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.xls binary
*.xlsx binary
*.zip binary
